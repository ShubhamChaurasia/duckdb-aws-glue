# name: test/sql/hive/ddl/drop_view/drop_view_on_table.test
# description: DROP VIEW on a Glue Hive table is refused and the table survives
# group: [drop_view]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.dv_orders;

statement ok
CREATE TABLE my_datalake.default.dv_orders (id INTEGER, amount DOUBLE);

statement ok
INSERT INTO my_datalake.default.dv_orders VALUES (1, 10.0), (2, 20.0);

query I
SELECT count(*) FROM my_datalake.default.dv_orders;
----
2

# ===========================================================================
# DROP VIEW on a table is refused, with DuckDB's own wording
# ===========================================================================
statement error
DROP VIEW my_datalake.default.dv_orders;
----
is of type Table, trying to drop type View

# the table survives -- the point of the test
query I
SELECT count(*) FROM my_datalake.default.dv_orders;
----
2

# and Glue still holds it as a table
query I
SELECT glue_table_type FROM glue_get_table_response('my_datalake.default.dv_orders');
----
EXTERNAL_TABLE

# ===========================================================================
# IF EXISTS does not suppress it: the object exists, it is merely the wrong
# type, which is what DuckDB does too (test/sql/catalog/test_if_not_exists.test)
# ===========================================================================
statement error
DROP VIEW IF EXISTS my_datalake.default.dv_orders;
----
is of type Table, trying to drop type View

query I
SELECT count(*) FROM my_datalake.default.dv_orders;
----
2

# ===========================================================================
# IF EXISTS on a genuinely absent name is still a no-op
# ===========================================================================
statement ok
DROP VIEW IF EXISTS my_datalake.default.dv_does_not_exist;

# ===========================================================================
# DROP TABLE is unaffected
# ===========================================================================
statement ok
DROP TABLE my_datalake.default.dv_orders;

statement error
SELECT count(*) FROM my_datalake.default.dv_orders;
----
does not exist
