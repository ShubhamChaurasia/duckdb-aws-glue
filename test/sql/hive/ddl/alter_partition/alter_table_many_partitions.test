# name: test/sql/hive/ddl/alter_partition/alter_table_many_partitions.test
# description: glue_alter_table with more actions than one DataChunk holds: every action is applied and reported
# group: [alter_partition]

# if_not_exists skips the per-action GetPartition pre-check, saving a Glue call per partition

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

# exactly one chunk
statement ok
DROP TABLE IF EXISTS my_datalake.default.many_2048;

statement ok
CREATE TABLE my_datalake.default.many_2048 (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

query I
SELECT count(*) FROM glue_alter_table('my_datalake.default.many_2048',
    list_transform(range(2048), lambda i: {
        action: 'add', if_not_exists: true, if_exists: NULL::BOOLEAN,
        partition: [{key: 'dt', value: 'p' || i::VARCHAR}],
        new_partition: NULL::STRUCT(key VARCHAR, value VARCHAR)[], location: NULL::VARCHAR}));
----
2048

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.many_2048');
----
2048

# one more than a chunk
statement ok
DROP TABLE IF EXISTS my_datalake.default.many_2049;

statement ok
CREATE TABLE my_datalake.default.many_2049 (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

query I
SELECT count(*) FROM glue_alter_table('my_datalake.default.many_2049',
    list_transform(range(2049), lambda i: {
        action: 'add', if_not_exists: true, if_exists: NULL::BOOLEAN,
        partition: [{key: 'dt', value: 'p' || i::VARCHAR}],
        new_partition: NULL::STRUCT(key VARCHAR, value VARCHAR)[], location: NULL::VARCHAR}));
----
2049

# every action is reported exactly once
query III
SELECT count(*), count(DISTINCT partition), count(DISTINCT action)
FROM glue_alter_table('my_datalake.default.many_2049',
    list_transform(range(2049), lambda i: {
        action: 'add', if_not_exists: true, if_exists: NULL::BOOLEAN,
        partition: [{key: 'dt', value: 'p' || i::VARCHAR}],
        new_partition: NULL::STRUCT(key VARCHAR, value VARCHAR)[], location: NULL::VARCHAR}));
----
2049	2049	1

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.many_2049');
----
2049

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.many_2049') WHERE dt IN ('p0', 'p2047', 'p2048');
----
3

# three chunks
statement ok
DROP TABLE IF EXISTS my_datalake.default.many_4097;

statement ok
CREATE TABLE my_datalake.default.many_4097 (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

query II
SELECT count(*), count(DISTINCT partition) FROM glue_alter_table('my_datalake.default.many_4097',
    list_transform(range(4097), lambda i: {
        action: 'add', if_not_exists: true, if_exists: NULL::BOOLEAN,
        partition: [{key: 'dt', value: 'p' || i::VARCHAR}],
        new_partition: NULL::STRUCT(key VARCHAR, value VARCHAR)[], location: NULL::VARCHAR}));
----
4097	4097

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.many_4097');
----
4097

statement ok
DROP TABLE my_datalake.default.many_2048;

statement ok
DROP TABLE my_datalake.default.many_2049;

statement ok
DROP TABLE my_datalake.default.many_4097;
