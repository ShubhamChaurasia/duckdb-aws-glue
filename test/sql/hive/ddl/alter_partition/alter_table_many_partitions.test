# name: test/sql/hive/ddl/alter_partition/alter_table_many_partitions.test
# description: glue_alter_table with more actions than one DataChunk holds: every action is applied and reported
# group: [alter_partition]

# glue_alter_table returns one row per action, so an ALTER TABLE registering more partitions than
# STANDARD_VECTOR_SIZE (2048) has to span several output chunks. The scan must page its output rather than
# writing every row into one chunk.
#
# Each case asserts the PAIR: the statement succeeds with the expected row count, AND Glue ends up holding
# exactly the expected partitions. The pair is the point. A count on its own does not distinguish "applied
# and reported" from "applied, then the statement failed on the way out" -- and the latter is the real
# hazard here, because glue_alter_table pre-checks every action against Glue specifically so that a
# statement which fails registers nothing. A failure after the writes defeats that.
#
# Actions are generated with list_transform over range() rather than written out, which folds to a constant
# at bind time (glue_alter_table reads the list in its bind). Note 'lambda i:' -- 'i -> ' is rejected.
#
# if_not_exists is true throughout so the pre-check loop skips its per-action GetPartition call; without it
# the test costs one extra Glue round-trip per partition and little more coverage.

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

# ===========================================================================
# exactly one chunk: 2048 actions. The control -- this passes even unpaged.
# ===========================================================================
statement ok
DROP TABLE IF EXISTS my_datalake.default.many_2048;

statement ok
CREATE TABLE my_datalake.default.many_2048 (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

query I
SELECT count(*) FROM glue_alter_table('my_datalake.default.many_2048',
    list_transform(range(2048), lambda i: {
        action: 'add', if_not_exists: true, if_exists: NULL::BOOLEAN,
        partition: [{key: 'dt', value: 'p' || i::VARCHAR}],
        new_partition: NULL::STRUCT(key VARCHAR, value VARCHAR)[], location: NULL::VARCHAR}));
----
2048

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.many_2048');
----
2048

# ===========================================================================
# one more than a chunk: 2049 actions, so the output spans two chunks
# ===========================================================================
statement ok
DROP TABLE IF EXISTS my_datalake.default.many_2049;

statement ok
CREATE TABLE my_datalake.default.many_2049 (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

query I
SELECT count(*) FROM glue_alter_table('my_datalake.default.many_2049',
    list_transform(range(2049), lambda i: {
        action: 'add', if_not_exists: true, if_exists: NULL::BOOLEAN,
        partition: [{key: 'dt', value: 'p' || i::VARCHAR}],
        new_partition: NULL::STRUCT(key VARCHAR, value VARCHAR)[], location: NULL::VARCHAR}));
----
2049

# every action is reported, once, and as an add -- a paging bug can preserve the
# count while duplicating or dropping rows, so check distinctness too
query III
SELECT count(*), count(DISTINCT partition), count(DISTINCT action)
FROM glue_alter_table('my_datalake.default.many_2049',
    list_transform(range(2049), lambda i: {
        action: 'add', if_not_exists: true, if_exists: NULL::BOOLEAN,
        partition: [{key: 'dt', value: 'p' || i::VARCHAR}],
        new_partition: NULL::STRUCT(key VARCHAR, value VARCHAR)[], location: NULL::VARCHAR}));
----
2049	2049	1

# and Glue holds exactly those partitions
query I
SELECT count(*) FROM glue_partitions('my_datalake.default.many_2049');
----
2049

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.many_2049') WHERE dt IN ('p0', 'p2047', 'p2048');
----
3

# ===========================================================================
# several chunks: 4097 actions, which forces a third page and would catch an
# off-by-one in the paging that a single boundary case can miss
# ===========================================================================
statement ok
DROP TABLE IF EXISTS my_datalake.default.many_4097;

statement ok
CREATE TABLE my_datalake.default.many_4097 (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

query II
SELECT count(*), count(DISTINCT partition) FROM glue_alter_table('my_datalake.default.many_4097',
    list_transform(range(4097), lambda i: {
        action: 'add', if_not_exists: true, if_exists: NULL::BOOLEAN,
        partition: [{key: 'dt', value: 'p' || i::VARCHAR}],
        new_partition: NULL::STRUCT(key VARCHAR, value VARCHAR)[], location: NULL::VARCHAR}));
----
4097	4097

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.many_4097');
----
4097

statement ok
DROP TABLE my_datalake.default.many_2048;

statement ok
DROP TABLE my_datalake.default.many_2049;

statement ok
DROP TABLE my_datalake.default.many_4097;
