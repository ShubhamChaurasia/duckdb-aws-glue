# name: test/sql/hive/ddl/views/test_drop_view.test
# description: DROP VIEW / DROP TABLE tell views and tables apart
# group: [views]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP VIEW IF EXISTS my_datalake.default.dv_view;

statement ok
DROP TABLE IF EXISTS my_datalake.default.dv_table;

statement ok
CREATE TABLE my_datalake.default.dv_table (id INTEGER);

statement ok
INSERT INTO my_datalake.default.dv_table VALUES (1);

statement ok
CREATE VIEW my_datalake.default.dv_view AS SELECT id FROM dv_table;

statement error
DROP TABLE my_datalake.default.dv_view;
----
Existing object dv_view is of type View, trying to drop type Table

statement error
DROP VIEW my_datalake.default.dv_table;
----
Existing object dv_table is of type Table, trying to drop type View

query I
SELECT * FROM my_datalake.default.dv_view;
----
1

statement ok
DROP VIEW my_datalake.default.dv_view;

query I
SELECT count(*) FROM duckdb_views() WHERE database_name = 'my_datalake' AND view_name = 'dv_view';
----
0

statement error
SELECT * FROM glue_get_table_response('my_datalake.default.dv_view');
----
does not exist

statement error
DROP VIEW my_datalake.default.dv_view;
----
does not exist

statement ok
DROP VIEW IF EXISTS my_datalake.default.dv_view;

query I
SELECT * FROM my_datalake.default.dv_table;
----
1

statement ok
DROP TABLE my_datalake.default.dv_table;
