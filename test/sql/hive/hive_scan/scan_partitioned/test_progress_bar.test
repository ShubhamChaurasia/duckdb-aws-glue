# name: test/sql/hive/hive_scan/scan_partitioned/test_progress_bar.test
# description: The progress bar completes on a lazily listed partitioned scan
# group: [scan_partitioned]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.pb_orders;

statement ok
CREATE TABLE my_datalake.default.pb_orders (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.pb_orders SELECT i, '2026-01-0' || i FROM range(1, 6) t(i);

# one thread: no worker lists partitions while the progress bar (on in this runner) asks for an exact file count, so the
# count has to list them itself
statement ok
SET threads = 1;

query I
SELECT count(*) FROM my_datalake.default.pb_orders;
----
5

statement ok
DROP TABLE my_datalake.default.pb_orders;
