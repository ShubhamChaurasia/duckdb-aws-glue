# name: test/sql/hive/catalog/catalog_function_pushdown.test
# description: the catalog functions narrowed to one Glue database give the same rows as the full enumeration
# group: [catalog]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
CREATE TABLE IF NOT EXISTS my_datalake.default.pushdown_a (i INT);

statement ok
CREATE TABLE IF NOT EXISTS my_datalake.default.pushdown_b (j VARCHAR);

# reference: the full enumeration
statement ok
CREATE TEMP TABLE reference AS
SELECT table_name FROM (SELECT * FROM duckdb_tables()) WHERE database_name = 'my_datalake' AND schema_name = 'default';

query I
SELECT count(*) > 0 FROM reference;
----
true

# database and schema
query I
SELECT (SELECT list(table_name ORDER BY table_name) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND schema_name = 'default')
     = (SELECT list(table_name ORDER BY table_name) FROM reference);
----
true

# SHOW TABLES
query I
SELECT (SELECT list(name ORDER BY name) FROM (SHOW TABLES FROM my_datalake.default)) = (SELECT list(table_name ORDER BY table_name) FROM reference);
----
true

# upper()
query I
SELECT (SELECT list(table_name ORDER BY table_name) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND upper(schema_name) = 'DEFAULT')
     = (SELECT list(table_name ORDER BY table_name) FROM reference);
----
true

# exact match
query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND schema_name IN ('Default', 'DEFAULT');
----
0

# named tables, one missing
query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'my_datalake' AND schema_name = 'default' AND table_name IN ('pushdown_b', 'pushdown_a', 'no_such_table');
----
pushdown_a
pushdown_b

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND schema_name = 'default' AND upper(table_name) = 'PUSHDOWN_A';
----
1

# one table's columns
query II
SELECT column_name, data_type FROM information_schema.columns WHERE table_catalog = 'my_datalake' AND table_schema = 'default' AND table_name = 'pushdown_b';
----
j	VARCHAR

# missing database
query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND schema_name = 'no_such_database_xyz';
----
0

statement ok
DROP TABLE my_datalake.default.pushdown_a;

statement ok
DROP TABLE my_datalake.default.pushdown_b;
