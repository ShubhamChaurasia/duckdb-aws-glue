# name: test/sql/hive/dml/insert/custom_locations/insert_nested_partitions.test
# description: INSERT into a partition registered inside the <key>=<value> directory of another partition
# group: [custom_locations]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
SET enable_external_file_cache=false;

statement ok
DROP TABLE IF EXISTS my_datalake.default.nested_parts;

statement ok
CREATE TABLE my_datalake.default.nested_parts (id INTEGER, part_1 VARCHAR) PARTITIONED BY (part_1);

# val2 lives inside the directory of val1, which is not registered yet
statement ok
CALL glue_add_partition('my_datalake.default.nested_parts', {part_1: 'val2'},
    location := '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/nested_parts/part_1=val1/other_partition/');

# the outer partition is created by the same INSERT that writes the inner one
statement ok
INSERT INTO my_datalake.default.nested_parts VALUES (1, 'val1'), (2, 'val2'), (3, 'val1');

query II
SELECT regexp_extract(file, 'nested_parts/(.*)/[^/]*$', 1) AS dir, count(*)
FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/nested_parts/**')
GROUP BY dir ORDER BY dir;
----
part_1=val1	1
part_1=val1/other_partition	1

query II
SELECT part_1, location FROM glue_partitions('my_datalake.default.nested_parts') ORDER BY part_1;
----
val1	{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/nested_parts/part_1=val1
val2	{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/nested_parts/part_1=val1/other_partition

# appending to each partition separately keeps the files apart
statement ok
INSERT INTO my_datalake.default.nested_parts VALUES (4, 'val2');

statement ok
INSERT INTO my_datalake.default.nested_parts VALUES (5, 'val1');

query II
SELECT regexp_extract(file, 'nested_parts/(.*)/[^/]*$', 1) AS dir, count(*)
FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/nested_parts/**')
GROUP BY dir ORDER BY dir;
----
part_1=val1	2
part_1=val1/other_partition	2

# the files below the inner location belong to the inner partition only, whether the table root or every partition
# is listed
foreach threshold 1 5

statement ok
SET hive_partition_listing_threshold = {threshold};

query II
SELECT part_1, list(id ORDER BY id) FROM my_datalake.default.nested_parts GROUP BY part_1 ORDER BY part_1;
----
val1	[1, 3, 5]
val2	[2, 4]

query I
SELECT id FROM my_datalake.default.nested_parts WHERE part_1 = 'val1' ORDER BY id;
----
1
3
5

query I
SELECT id FROM my_datalake.default.nested_parts WHERE part_1 = 'val2' ORDER BY id;
----
2
4

endloop

statement ok
RESET hive_partition_listing_threshold;

statement ok
DROP TABLE my_datalake.default.nested_parts;

#---------------------------------------------------------------------------
# two partition keys: the inner partition lives inside the full <key>=<value>/<key>=<value> directory of another
#---------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.nested_parts_2;

statement ok
CREATE TABLE my_datalake.default.nested_parts_2 (id INTEGER, part_1 VARCHAR, part_2 INTEGER) PARTITIONED BY (part_1, part_2);

statement ok
CALL glue_add_partition('my_datalake.default.nested_parts_2', {part_1: 'val1', part_2: 1});

statement ok
CALL glue_add_partition('my_datalake.default.nested_parts_2', {part_1: 'val1', part_2: 2},
    location := '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/nested_parts_2/part_1=val1/part_2=1/other_partition');

statement ok
INSERT INTO my_datalake.default.nested_parts_2 VALUES (1, 'val1', 1), (2, 'val1', 2), (3, 'val1', 3);

query II
SELECT regexp_extract(file, 'nested_parts_2/(.*)/[^/]*$', 1) AS dir, count(*)
FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/nested_parts_2/**')
GROUP BY dir ORDER BY dir;
----
part_1=val1/part_2=1	1
part_1=val1/part_2=1/other_partition	1
part_1=val1/part_2=3	1

query III
SELECT id, part_1, part_2 FROM my_datalake.default.nested_parts_2 ORDER BY id;
----
1	val1	1
2	val1	2
3	val1	3

query I
SELECT id FROM my_datalake.default.nested_parts_2 WHERE part_2 = 1;
----
1

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.nested_parts_2');
----
3

statement ok
DROP TABLE my_datalake.default.nested_parts_2;
