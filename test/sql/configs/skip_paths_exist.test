# name: test/sql/configs/skip_paths_exist.test
# description: Every path in a runner config's skip_tests must name a test file that exists.
# group: [configs]

# Why this exists. TestConfiguration::ShouldSkipTest matches a test by exact string against an
# unordered_set, and the config loader validates nothing except that an entry is not listed twice. A
# skip path that matches no file on disk is therefore accepted in silence: the entry is dead, and the
# test it was meant to skip runs anyway. Renaming a test file, or a typo, produces this with no
# warning from anything.
#
# That is not hypothetical -- it is how cloud_glue.json came to skip 'msck_repair_table.test' and
# 'show_partitions.test' while the real files were named 'glue_repair_table.test' and
# 'test_show_partitions.test', so both ran under the cloud config and failed on a missing function.
#
# This test needs no Glue, no S3 and no fixture: it compares the configs against the filesystem. It
# is generic, so it also covers configs and entries added later.
#
# It does NOT tell you an entry is obsolete. A skip whose reason no longer applies -- the feature got
# implemented -- still names a real file and still passes here. That part needs a human.

require json

# The test files that actually exist. '*.test*' rather than '*.test' on purpose: it also covers
# .test_slow and .test_coverage, which a skip list may legitimately name. Globbing only '*.test'
# reports an existing .test_slow as missing.
statement ok
CREATE OR REPLACE TEMP MACRO existing_tests() AS TABLE
    SELECT replace(file, '\', '/') AS path FROM glob('test/sql/**/*.test*');

# Sanity: the glob finds the suite at all. Without this, a broken glob (or a runner whose working
# directory is not the extension root) would make the assertions below pass by finding nothing.
query I
SELECT count(*) > 20 FROM existing_tests();
----
true

# Every skip_tests path of every runner config, tagged with the config it came from. Each config's
# own entries are read literally; inherited chains (base_config / inherit_skip_tests) are checked in
# whichever file declares them.
statement ok
CREATE OR REPLACE TEMP MACRO skipped_paths() AS TABLE
    SELECT config, unnest(entry.paths) AS path
    FROM (
        SELECT replace(filename, '\', '/') AS config, unnest(skip_tests) AS entry
        FROM read_json('test/configs/*.json', filename := true, union_by_name := true)
        WHERE skip_tests IS NOT NULL
    );

# Sanity: there are skip entries to check.
query I
SELECT count(*) > 0 FROM skipped_paths();
----
true

# ---------------------------------------------------------------------------
# no config names a skip path that does not exist
# ---------------------------------------------------------------------------
# On failure this lists the offenders as "<config> <path>", which is what you need to fix them.
query II
SELECT config, path
FROM skipped_paths()
WHERE path NOT IN (SELECT path FROM existing_tests())
ORDER BY config, path;
----

# The same claim as a count, so the failure is readable either way.
query I
SELECT count(*) FROM skipped_paths() WHERE path NOT IN (SELECT path FROM existing_tests());
----
0
